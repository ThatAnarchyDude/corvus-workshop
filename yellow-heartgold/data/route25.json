  "messages": {
    "Route25Youngster1BattleText": "Local trainers come here to practice!",
    "Route25Youngster1EndBattleText": "You're decent.",
    "Route25Youngster1AfterBattleText": "All POKEMON have weaknesses. It's best to raise different kinds.",
    "Route25Youngster2BattleText": "Dad took me to a great party on S.S.ANNE at VERMILION CITY!",
    "Route25Youngster2EndBattleText": "I'm not mad!",
    "Route25Youngster2AfterBattleText": "On S.S.ANNE, I saw trainers from around the world.",
    "Route25CooltrainerMBattleText": "I'm a cool guy. I've got a girl friend!",
    "Route25CooltrainerMEndBattleText": "Aww, darn...",
    "Route25CooltrainerMAfterBattleText": "Oh well. My girl will cheer me up.",
    "Route25CooltrainerF1BattleText": "Hi! My boy friend is cool!",
    "Route25CooltrainerF1EndBattleText": "I'm in a slump!",
    "Route25CooltrainerF1AfterBattleText": "I wish my guy was as good as you!",
    "Route25Youngster3BattleText": "I knew I had to fight you!",
    "Route25Youngster3EndBattleText": "I knew I'd lose too!",
    "Route25Youngster3AfterBattleText": "If your POKEMON gets confused or falls asleep, switch it!",
    "Route25CooltrainerF2BattleText": "My friend has a cute POKEMON. I'm so jealous!",
    "Route25CooltrainerF2EndBattleText": "I'm not so jealous!",
    "Route25CooltrainerF2AfterBattleText": "You came from MT. MOON? May I have a CLEFAIRY?",
    "Route25Hiker1BattleText": "I just got down from MT.MOON, but I'm ready!",
    "Route25Hiker1EndBattleText": "You worked hard!",
    "Route25Hiker1AfterBattleText": "Drat! A ZUBAT bit me back in there.",
    "Route25Hiker2BattleText": "I'm off to see a POKEMON collector at the cape!",
    "Route25Hiker2EndBattleText": "You got me.",
    "Route25Hiker2AfterBattleText": "The collector has many rare kinds of POKEMON.",
    "Route25Hiker3BattleText": "You're going to see BILL? First, let's fight!",
    "Route25Hiker3EndBattleText": "You're something.",
    "Route25Hiker3AfterBattleText": "The trail below is a shortcut to CERULEAN CITY.",
    "Route25BillSignText": "SEA COTTAGE BILL lives here!",
    "BillsHouseBillDontLeaveText": "Whoa, don't go anywhere, wait!",
    "BillsHouseBillImNotAPokemonText": "Hiya! I'm a POKEMON... ...No I'm not!\rCall me BILL! I'm a true blue POKEMANIAC! Hey! What's with that skeptical look?\rI'm not joshing you, I screwed up an experiment and got combined with a POKEMON!\rSo, how about it? Help me out here!",
    "BillsHouseBillUseSeparationSystemText": "When I'm in the TELEPORTER, go to my PC and run the Cell Separation System!",
    "BillsHouseBillNoYouGottaHelpText": "No!? Come on, you gotta help a guy in deep trouble!\rWhat do you say, chief? Please? OK? All right!",
    "BillsHouseBillThankYouText": "BILL: Yeehah! Thanks, bud! I owe you one!\rSo, did you come to see my POKEMON collection? You didn't? That's a bummer.\rI've got to thank you... Oh here, maybe this'll do.",
    "BillsHouseBillWhyDontYouGoInsteadOfMeText": "That cruise ship, S.S.ANNE, is in VERMILION CITY. Its passengers are all trainers!\rThey invited me to their party, but I can't stand fancy do's. Why don't you go instead of me?",
    "BillsHouseBillCheckOutMyRarePokemonText": "BILL: Look, bud, just check out some of my rare POKEMON on my PC!",
    "BillsHouseMonitorText": "TELEPORTER is displayed on the PC monitor.",
    "BillsHouseInitiatedText": "{PLAYER} initiated TELEPORTER's Cell Separator!",
    "BillsHousePokemonListText1": "BILL's favorite POKEMON list!",
    "BillsHousePokemonListText2": "Which POKEMON do you want to see?"
  },
