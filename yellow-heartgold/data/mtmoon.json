  "messages": {
    "MtMoon1FHikerBattleText": "WHOA! You shocked me! Oh, you're just a kid!",
    "MtMoon1FHikerEndBattleText": "Wow! Shocked again!",
    "MtMoon1FHikerAfterBattleText": "Kids like you shouldn't be here!",
    "MtMoon1FYoungster1BattleText": "Did you come to explore too?",
    "MtMoon1FYoungster1EndBattleText": "Losing stinks!",
    "MtMoon1FYoungster1AfterBattleText": "I came down here to show off to girls.",
    "MtMoon1FCooltrainerF1BattleText": "Wow! It's way bigger in here than I thought!",
    "MtMoon1FCooltrainerF1EndBattleText": "Oh! I lost it!",
    "MtMoon1FCooltrainerF1AfterBattleText": "How do you get out of here?",
    "MtMoon1FSuperNerdBattleText": "What! Don't sneak up on me!",
    "MtMoon1FSuperNerdEndBattleText": "My POKEMONMON won't do!",
    "MtMoon1FSuperNerdAfterBattleText": "I have to find stronger POKEMONMON.",
    "MtMoon1FCooltrainerF2BattleText": "What? I'm waiting for my friends to find me here.",
    "MtMoon1FCooltrainerF2EndBattleText": "I lost?",
    "MtMoon1FCooltrainerF2AfterBattleText": "I heard there are some very rare fossils here.",
    "MtMoon1FYoungster2BattleText": "Suspicious men are in the cave. What about you?",
    "MtMoon1FYoungster2EndBattleText": "You got me!",
    "MtMoon1FYoungster2AfterBattleText": "I saw them! I'm sure they're from TEAM ROCKET!",
    "MtMoon1FYoungster3BattleText": "Go through this cave to get to CERULEAN CITY!",
    "MtMoon1FYoungster3EndBattleText": "I lost.",
    "MtMoon1FYoungster3AfterBattleText": "ZUBAT is tough! But, it can be useful if you catch one.",
    "MtMoon1FBewareZubatSign": "Beware! ZUBAT is a bloodsucker!",
    "MtMoonJessieJamesText1": "Stop right there!",
    "MtMoonJessieJamesText2": "That fossil is TEAM ROCKET's!\rSurrender now, or  prepare to fight!",
    "MtMoonJessieJamesText3": "A brat beat us?",
    "MtMoonJessieJamesText4": "TEAM ROCKET, blast off at the speed of light!",
    "MtMoonB2FDomeFossilYouWantText": "You want the DOME FOSSIL?",
    "MtMoonB2FHelixFossilYouWantText": "You want the HELIX FOSSIL?",
    "MtMoonB2FReceivedFossilText": "{PLAYER} got the  !",
    "MtMoonB2FYouHaveNoRoomText": "Look, you've got no room for this.",
    "MtMoonB2FSuperNerdTheyreBothMineText": "Hey, stop!\rI found these fossils! They're both mine!",
    "MtMoonB2FSuperNerdOkIllShareText": "OK! I'll share!",
    "MtMoonB2fSuperNerdEachTakeOneText": "We'll each take one! No being greedy!",
    "MtMoonB2FSuperNerdTheresAPokemonLabText": "Far away, on CINNABAR ISLAND, there's a POKEMONMON LAB.\rThey do research on regenerating fossils.",
    "MtMoonB2FSuperNerdThenThisIsMineText": "All right. Then this is mine!",
    "MtMoonB2FRocket2BattleText": "We, TEAM ROCKET, are POKEMONMON gangsters!",
    "MtMoonB2FRocket2EndBattleText": "I blew it!",
    "MtMoonB2FRocket2AfterBattleText": "Darn it all! My associates won't stand for this!",
    "MtMoonB2FRocket3BattleText": "We're pulling a big job here! Get lost, kid!",
    "MtMoonB2FRocket3EndBattleText": "So, you are good.",
    "MtMoonB2FRocket3AfterBattleText": "If you find a fossil, give it to me and scram!",
    "MtMoonB2FRocket4BattleText": "Little kids should leave grown-ups alone!",
    "MtMoonB2FRocket4EndBattleText": "I'm steamed!",
    "MtMoonB2FRocket4AfterBattleText": "POKEMONMON lived here long before people came."
  },
