  "messages": {
    "Route3Text1": "Whew... I better take a rest... Groan...\rThat tunnel from CERULEAN takes a lot out of you!",
    "Route3Youngster1BattleText": "Hey! I met you in VIRIDIAN FOREST!",
    "Route3Youngster1EndBattleText": "You beat me again!",
    "Route3Youngster1AfterBattleText": "There are other kinds of POKEMON than those found in the forest!",
    "Route3Youngster2BattleText": "Hi! I like shorts! They're comfy and easy to wear!",
    "Route3Youngster2EndBattleText": "I don't believe it!",
    "Route3Youngster2AfterBattleText": "Are you storing your POKEMON on PC? Each BOX can hold 30 POKEMON!",
    "Route3CooltrainerF1BattleText": "You looked at me, didn't you?",
    "Route3CooltrainerF1EndBattleText": "You're mean!",
    "Route3CooltrainerF1AfterBattleText": "Quit staring if you don't want to fight!",
    "Route3Youngster3BattleText": "Are you a trainer? Let's fight!",
    "Route3Youngster3EndBattleText": "If I had new POKEMON, I would've won!",
    "Route3Youngster3AfterBattleText": "If a POKEMON BOX on the PC gets full, just switch to another BOX!",
    "Route3CooltrainerF2BattleText": "That look you gave me, it's so intriguing!",
    "Route3CooltrainerF2EndBattleText": "Be nice!",
    "Route3CooltrainerF2AfterBattleText": "Avoid fights by not letting people see you!",
    "Route3Youngster4BattleText": "Hey! You're not wearing shorts!",
    "Route3Youngster4EndBattleText": "Lost! Lost! Lost!",
    "Route3Youngster4AfterBattleText": "I always wear shorts, even in winter!",
    "Route3Youngster5BattleText": "You can fight my new POKEMON!",
    "Route3Youngster5EndBattleText": "Done like dinner!",
    "Route3Youngster5AfterBattleText": "Trained POKEMON are stronger than the wild ones!",
    "Route3CooltrainerF3BattleText": "Eek! Did you touch me?",
    "Route3CooltrainerF3EndBattleText": "That's it?",
    "Route3CooltrainerF3AfterBattleText": "ROUTE 4 is at the foot of MT.MOON.",
    "Route3SignText": "ROUTE 3 MT.MOON AHEAD"
  },
