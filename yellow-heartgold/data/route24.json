  "messages": {
    "Route24CooltrainerM1YouBeatOurContestText": "Congratulations! You beat our 5 contest trainers!",
    "Route24CooltrainerM1YouJustEarnedAPrizeText": "You just earned a fabulous prize!",
    "Route24CooltrainerM1ReceivedNuggetText": "{PLAYER} received a NUGGET!",
    "Route24CooltrainerM1NoRoomText": "You don't have any room!",
    "Route24CooltrainerM1JoinTeamRocketText": "By the way, would you like to join TEAM ROCKET?\rWe're a group dedicated to evil using POKEMON!\rWant to join?\rAre you sure?\rCome on, join us!\rI'm telling you to join!\rOK, you need convincing!\rI'll make you an offer you can't refuse!",
    "Route24CooltrainerM1DefeatedText": "Arrgh! You are good!",
    "Route24CooltrainerM1YouCouldBecomeATopLeaderText": "With your ability, you could become a top leader in TEAM ROCKET!",
    "Route24CooltrainerM2BattleText": "I saw your feat from the grass!",
    "Route24CooltrainerM2EndBattleText": "I thought not!",
    "Route24CooltrainerM2AfterBattleText": "I hid because the people on the bridge scared me!",
    "Route24CooltrainerM3BattleText": "OK! I'm No. 5! I'll stomp you!",
    "Route24CooltrainerM3EndBattleText": "Whoa! Too much!",
    "Route24CooltrainerM3AfterBattleText": "I did my best, I have no regrets!",
    "Route24CooltrainerF1BattleText": "I'm No. 4! Getting tired?",
    "Route24CooltrainerF1EndBattleText": "I lost too!",
    "Route24CooltrainerF1AfterBattleText": "I did my best, so I've no regrets!",
    "Route24Youngster1BattleText": "Here's No. 3! I won't be easy!",
    "Route24Youngster1EndBattleText": "Ow! Stomped flat!",
    "Route24Youngster1AfterBattleText": "I did my best, I have no regrets!",
    "Route24CooltrainerF2BattleText": "I'm second! Now it's serious!",
    "Route24CooltrainerF2EndBattleText": "How could I lose?",
    "Route24CooltrainerF2AfterBattleText": "I did my best, I have no regrets!",
    "Route24Youngster2BattleText": "This is NUGGET BRIDGE! Beat us 5 trainers and win a fabulous prize!\rThink you got what it takes?",
    "Route24Youngster2EndBattleText": "Whoo! Good stuff!",
    "Route24Youngster2AfterBattleText": "I did my best, I have no regrets!",
    "Route24DamianText1": "I'm not good at raising POKEMON.\rI should release my CHARMANDER because I haven't raised it well...\rIf you promise me you'll care for it, it's yours.",
    "Route24DamianText2": "Take good care of my CHARMANDER!",
    "Route24DamianText3": "Oh... I'd better release it then.",
    "Route24DamianText4": "How's CHARMANDER doing?"
  },
